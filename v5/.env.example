# METIS v4 — Environment Variables Template
# Copy to .env and fill in. Never commit .env.

# ── Mode ──
PAPER_MODE=true
PAPER_INITIAL_BALANCE_USDT=200.0

# ── Bybit ──
# For PAPER_MODE=true: mainnet public data (no signed calls). API keys still required for protected endpoints in live mode.
BYBIT_USE_TESTNET=false
BYBIT_API_KEY=
BYBIT_SECRET=
# IMPORTANT: trade-only key, withdrawal disabled, IP allowlist set (R5 condition #8).

# ── Gemini ──
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.5-flash

# ── Telegram (optional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Paths (optional override) ──
# METIS_DATA_DIR=/var/lib/metis/data
# METIS_LOGS_DIR=/var/lib/metis/logs
