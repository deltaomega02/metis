# METIS v6 environment (copy to ../.env on the VM; gitignored)
PAPER_MODE=true
PAPER_INITIAL_BALANCE_USDT=1000

# PAPER 엔진이 돌릴 암 부분선택(쉼표 목록). 미설정 시 4암(none/fast/slow/ls) 전부.
# 라이브와 별도로 페이퍼 ls만 동시 운영할 때: PAPER_ARMS_ONLY=ls
PAPER_ARMS_ONLY=

# 사이클 발화 버퍼(초). 봉마감 정각 글로벌 혼잡(retCode 10006) 회피용.
# 두 엔진(라이브/페이퍼)을 한 IP에서 동시 운영하면 서로 다른 값으로 어긋낼 것(예: 라이브 45, 페이퍼 150).
CYCLE_BUFFER_SEC=45

# Telegram (optional but recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bybit — only needed when PAPER_MODE=false (live). Paper uses public data only.
BYBIT_API_KEY=
BYBIT_SECRET=
BYBIT_USE_TESTNET=false

# Dashboard P&L display seed (optional)
BYBIT_REAL_SEED_USDT=0
BYBIT_REAL_SEED_KRW=0

DASHBOARD_PORT=8501
