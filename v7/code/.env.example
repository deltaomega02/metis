# METIS v6 environment (copy to ../.env on the VM; gitignored)
PAPER_MODE=true
PAPER_INITIAL_BALANCE_USDT=1000

# Telegram (optional but recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bybit — only needed when PAPER_MODE=false (live). Paper uses public data only.
BYBIT_API_KEY=
BYBIT_SECRET=
BYBIT_USE_TESTNET=false

# Dashboard P&L display seed (optional)
BYBIT_REAL_SEED_USDT=0
BYBIT_REAL_SEED_KRW=0

DASHBOARD_PORT=8501
