[Unit]
Description=Funding carry bot (delta-neutral, 1x no-borrow)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/home/botuser/metis-v4
ExecStart=/home/botuser/metis-v4/run_carry.sh
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
